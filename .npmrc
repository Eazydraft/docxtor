# Route all @eazydraft-scoped packages through GitHub Packages
@eazydraft:registry=https://npm.pkg.github.com

# Authentication token — set via environment variable or .npmrc in home directory.
# Never commit a real token here.
# To authenticate locally, run:
#   npm login --scope=@eazydraft --auth-type=legacy --registry=https://npm.pkg.github.com
# Or add the following line to ~/.npmrc:
#   //npm.pkg.github.com/:_authToken=YOUR_GITHUB_PAT