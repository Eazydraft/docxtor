{
  "name": "@eazydraft/docxtor",
  "description": "Surgical, LLM-friendly DOCX editing through normalized AST with direct XML mutation",
  "version": "0.1.2",
  "author": {
    "name": "Randeep Singh",
    "email": "randeep@lucioai.com"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Eazydraft/docxtor.git"
  },
  "keywords": [
    "docx",
    "word",
    "document",
    "editing",
    "llm",
    "patch",
    "ooxml"
  ],
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "logo.png"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.10",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "openai": "^6.33.0"
  }
}
