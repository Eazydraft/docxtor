{
  "name": "@lucio-ai/docxtor",
  "description": "Surgical, LLM-friendly DOCX editing through normalized AST with direct XML mutation",
  "version": "0.5.0",
  "author": {
    "name": "Randeep Singh",
    "email": "randeep@lucioai.com"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eazydraft/docxtor.git"
  },
  "homepage": "https://github.com/Eazydraft/docxtor#readme",
  "bugs": {
    "url": "https://github.com/Eazydraft/docxtor/issues"
  },
  "keywords": [
    "docx",
    "word",
    "document",
    "editing",
    "llm",
    "patch",
    "agent-skill"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "docxtor": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.cli.config.ts",
    "build:skill": "tsdown -c tsdown.skill.config.ts",
    "pack:skill": "pnpm build:skill && rm -f docxtor-skill.zip && cd plugin/skills && zip -qr ../../docxtor-skill.zip docxtor",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json",
    "prepublishOnly": "pnpm build",
    "lint": "publint && attw --pack .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^25.5.2",
    "openai": "^6.33.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
