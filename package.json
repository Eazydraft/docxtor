{
  "name": "@eazydraft/docxtor",
  "description": "Surgical, LLM-friendly DOCX editing through normalized AST with direct XML mutation",
  "version": "0.1.5",
  "author": {
    "name": "Randeep Singh",
    "email": "randeep@lucioai.com"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eazydraft/docxtor.git"
  },
  "keywords": [
    "docx",
    "word",
    "document",
    "editing",
    "llm",
    "patch",
    "ooxml"
  ],
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "logo.png"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.7.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@types/node": "^25.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "openai": "^6.33.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
