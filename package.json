{
  "name": "@lucio-ai/docxtor",
  "description": "Surgical, LLM-friendly DOCX editing through normalized AST with direct XML mutation",
  "version": "0.4.1",
  "author": {
    "name": "Randeep Singh",
    "email": "randeep@lucioai.com"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eazydraft/docxtor.git"
  },
  "homepage": "https://github.com/Eazydraft/docxtor#readme",
  "bugs": {
    "url": "https://github.com/Eazydraft/docxtor/issues"
  },
  "keywords": [
    "docx",
    "word",
    "document",
    "editing",
    "llm",
    "patch",
    "ooxml"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "logo.png"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "lint": "publint && attw --pack .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.7.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "openai": "^7.47.0",
    "publint": "^0.3.18",
    "tsdown": "^0.23.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
